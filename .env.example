# --- REQUIRED CONFIGURATION ---

# Supabase: Find these in Project Settings > API
# SUPABASE_URL: Your project's API URL
SUPABASE_URL=

# SUPABASE_KEY: Use 'service_role' key for backend operations to bypass RLS, 
# or 'anon' key for public-only access.
SUPABASE_KEY=your_service_role_or_anon_key_here

# Resend: Find in Resend Dashboard > API Keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=your_admin_email@example.com

# Frontend URL: Required for CORS (e.g., your Vercel URL)
FRONTEND_URL=https://your-frontend.vercel.app


# --- OPTIONAL / ENVIRONMENT CONFIGURATION ---

ENVIRONMENT=development # development, staging, or production
API_PREFIX=/api

# Rate Limiting (Requests per window)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_MINUTES=15

# AI Services (Required for insights and analysis features)
# Find in Google AI Studio
GOOGLE_API_KEY=your_gemini_api_key_here

# Find in HuggingFace Settings > Tokens
HUGGINGFACE_TOKEN=your_huggingface_access_token_here

# LiteLLM Proxy (Only if self-hosting the proxy)
# LITELLM_PROXY_URL=http://localhost:4000
# LITELLM_MASTER_KEY=sk-1234

# --- INFRASTRUCTURE (Optional) ---
# REDIS_URL=redis://localhost:6379
# SENTRY_DSN=your_sentry_dsn
